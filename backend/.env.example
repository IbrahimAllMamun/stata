DATABASE_URL="postgresql://user:password@127.0.0.1:5432/postgres"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE=2097152
UPLOAD_PATH=uploads
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Bootstraps the first staff account (npm run prisma:seed). Promotes the member
# with this email to role=admin, creating a placeholder member if none exists.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="at-least-8-characters"
# Only used when the member does not already exist:
SEED_ADMIN_NAME="STATA Admin"
SEED_ADMIN_BATCH=0

# The address that campaign emails and password resets are sent FROM (required)
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=STATA

# ── Sending: Resend over HTTPS (preferred) ────────────────────────────────────
# Set this and the app sends through Resend's API on port 443, which shared
# hosts do not block the way they block outbound SMTP. Campaigns go out in
# batches of 100 per request. Leave it unset to fall back to the SMTP block.
RESEND_API_KEY=re_your_api_key_here

# ── Sending: SMTP fallback ────────────────────────────────────────────────────
# Used only when RESEND_API_KEY is empty. For Resend the username is the literal
# string "resend" and the password is an API key; one credential signs for every
# From address on the verified domain.
#
# SMTP_PORT/SMTP_SECURE must agree: 465 is implicit TLS (true), 587 is STARTTLS
# (false). Setting 587 with SMTP_SECURE=true hangs until the connection times
# out. Leave SMTP_SECURE unset to derive it from the port automatically.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<your Resend API key, re_...>

# ── Receiving: the domain's real mailbox host ─────────────────────────────────
# Resend is send-only, so the Communications inbox reads from wherever the
# domain's MX actually points. For a Google Workspace domain that is Gmail, and
# INFO_EMAIL_PASS is a Google App Password (needs 2-Step Verification on).
# Leave IMAP_HOST blank to disable the inbox; sending is unaffected.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
INFO_EMAIL=info@yourdomain.com
INFO_EMAIL_PASS=<App Password for info@yourdomain.com>